APP_NAME=Hology Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite+aiosqlite:///./hology.db
# For PostgreSQL: postgresql+asyncpg://hology:hology@localhost:5432/hology
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

SPEECH_ENERGY_DBFS=-45
SPEECH_VAD_THRESHOLD=0.6
SPEECH_MIN_SNR_DB=5

# Speech pipeline requires ML extras (no fallback):
# uv sync --extra speech --extra dev
# Note: use Python 3.11 — deepfilterlib has no wheels for 3.12+
